@@ -0,0 +1,479 @@
+/* OllO's calmer learning-first visual system */
+:root {
+  color-scheme: light;
+  color: #17251d;
+  background: #f3f6f1;
+  --bg: #f3f6f1;
+  --surface: #ffffff;
+  --surface-2: #e9efe8;
+  --cream: #17251d;
+  --muted: #718077;
+  --yellow: #d8ed83;
+  --green: #267553;
+  --orange: #b97835;
+  --red: #b85a52;
+  --border: #e0e8df;
+  --shadow-soft: 0 10px 30px rgba(26, 50, 35, .055);
+}
+
+html { scroll-behavior: smooth; }
+body {
+  background: var(--bg);
+  color: var(--cream);
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  letter-spacing: -0.01em;
+}
+button, input, textarea, select { font: inherit; }
+button { -webkit-tap-highlight-color: transparent; }
+button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {
+  outline: 3px solid rgba(38, 117, 83, .35);
+  outline-offset: 3px;
+}
+button:disabled { opacity: .55; cursor: not-allowed; }
+
+.app-shell {
+  width: min(100%, 1020px);
+  min-height: 100vh;
+  padding: max(20px, env(safe-area-inset-top)) 34px max(30px, env(safe-area-inset-bottom));
+  overflow: visible;
+}
+.topbar {
+  min-height: 62px;
+  margin-bottom: 12px;
+  gap: 12px;
+}
+.topbar .icon-button, .topbar .icon-button.big {
+  width: 44px;
+  height: 44px;
+  flex-basis: 44px;
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  background: var(--surface);
+  color: var(--cream);
+  box-shadow: none;
+  font-size: 22px;
+}
+.topbar .icon-button.active { background: var(--yellow); border-color: transparent; }
+.topbar .back-button { background: transparent; border-color: transparent; color: var(--cream); }
+.topbar .pill-button {
+  min-width: 0;
+  padding: 10px 18px;
+  border-radius: 12px;
+  background: var(--cream);
+  color: #fff;
+  box-shadow: none;
+  font-size: 13px;
+  font-weight: 750;
+  letter-spacing: .02em;
+  text-transform: uppercase;
+}
+.search-input {
+  width: min(310px, 48vw);
+  padding: 11px 14px;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  background: var(--surface);
+  color: var(--cream);
+}
+.page-heading { color: var(--cream); font-size: 15px; letter-spacing: .11em; }
+
+.home-screen, .folder-screen, .study-screen, .editor-screen, .sync-screen, .settings-screen {
+  min-height: calc(100vh - 110px);
+}
+.motivation-row {
+  min-height: 184px;
+  padding: 6px 4px 16px;
+  gap: 22px;
+}
+.quote {
+  max-width: 520px;
+  color: #2a684d;
+  font-family: inherit;
+  font-size: clamp(20px, 3.3vw, 29px);
+  font-weight: 720;
+  letter-spacing: -.045em;
+  line-height: 1.25;
+  transform: none;
+}
+.ollo-mascot { width: clamp(138px, 26vw, 206px); color: #193a2b; cursor: default; }
+.floaty-quote, .floaty-word, .floaty-word > span { animation: none !important; opacity: 1 !important; transform: none !important; }
+
+.home-intro {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 20px;
+  padding: 10px 2px 18px;
+}
+.eyebrow {
+  display: block;
+  color: var(--muted);
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .14em;
+  line-height: 1.3;
+}
+.home-intro h1 {
+  margin: 5px 0 2px;
+  color: var(--cream);
+  font-size: clamp(26px, 4vw, 34px);
+  font-weight: 780;
+  letter-spacing: -.055em;
+  line-height: 1.08;
+}
+.home-intro p { margin: 5px 0 0; color: var(--muted); font-size: 14px; }
+.library-total {
+  display: flex;
+  align-items: baseline;
+  gap: 6px;
+  padding: 8px 0 4px 14px;
+  color: var(--muted);
+  white-space: nowrap;
+}
+.library-total strong { color: var(--cream); font-size: 26px; letter-spacing: -.05em; }
+.library-total span { font-size: 12px; }
+
+.review-launch {
+  width: 100%;
+  min-height: 112px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 20px;
+  margin: 0 0 28px;
+  padding: 21px 23px;
+  border: 1px solid transparent;
+  border-radius: 20px;
+  background: #183d2c;
+  color: #fff;
+  text-align: left;
+  box-shadow: var(--shadow-soft);
+  transition: transform .16s ease, background .16s ease;
+}
+.review-launch:not(:disabled):active { transform: scale(.99); }
+.review-launch .eyebrow { color: #b6d4be; }
+.review-launch-copy { display: flex; flex-direction: column; gap: 5px; }
+.review-launch-copy strong { color: #fff; font-size: 23px; font-weight: 760; letter-spacing: -.04em; }
+.review-launch-copy small { color: #d4e3d7; font-size: 12px; }
+.review-launch-action {
+  display: inline-flex;
+  align-items: center;
+  gap: 13px;
+  padding: 11px 14px;
+  border-radius: 12px;
+  background: #d8ed83;
+  color: #183d2c;
+  font-size: 12px;
+  font-weight: 800;
+  white-space: nowrap;
+}
+.review-launch:disabled { background: #e7eee6; border-color: var(--border); color: var(--cream); opacity: 1; }
+.review-launch:disabled .eyebrow, .review-launch:disabled .review-launch-copy small { color: var(--muted); }
+.review-launch:disabled .review-launch-copy strong { color: var(--cream); }
+.review-launch:disabled .review-launch-action { background: #dce8dc; color: #587261; }
+
+.folder-list {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 13px;
+  padding: 0 0 130px;
+}
+.folder-tile {
+  min-height: 104px;
+  padding: 19px 20px;
+  border: 1px solid var(--border);
+  border-radius: 17px;
+  background: var(--surface);
+  color: var(--cream);
+  box-shadow: var(--shadow-soft);
+  transition: transform .16s ease, border-color .16s ease;
+}
+.folder-tile:active { transform: scale(.985); }
+.folder-tile strong { font-size: 17px; font-weight: 720; letter-spacing: -.03em; }
+.folder-tile span { margin-top: 7px; color: var(--muted); font-size: 12px; }
+.folder-tile i { padding: 0 3px; color: #a2afa4; font-style: normal; }
+.home-bottom-actions {
+  width: min(calc(100% - 44px), 930px);
+  bottom: max(20px, env(safe-area-inset-bottom));
+  justify-content: flex-end;
+  gap: 11px;
+}
+.home-bottom-actions::before { height: 112px; background: linear-gradient(to bottom, transparent, var(--bg) 72%); }
+.floating-play, .floating-add {
+  width: 54px;
+  height: 54px;
+  border-radius: 17px;
+  background: #183d2c;
+  color: #fff;
+  box-shadow: 0 8px 22px rgba(20, 55, 37, .18);
+  font-size: 25px;
+}
+.floating-add { border-radius: 50%; background: var(--yellow); color: #233b2a; }
+.settings-shortcut {
+  width: 48px;
+  height: 48px;
+  border: 1px solid var(--border);
+  border-radius: 50%;
+  background: var(--surface);
+  color: var(--muted);
+  font-size: 21px;
+}
+
+.folder-management-card {
+  margin-bottom: 19px;
+  padding: 20px;
+  border: 1px solid var(--border);
+  border-radius: 18px;
+  background: var(--surface);
+  box-shadow: var(--shadow-soft);
+}
+.folder-management-top { padding-bottom: 14px; border-bottom: 1px solid var(--border); }
+.folder-management-top strong { font-size: clamp(21px, 4vw, 27px); letter-spacing: -.045em; }
+.row-actions { gap: 14px; }
+.text-icon { font-size: 21px; }
+.folder-management-bottom {
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 12px 18px;
+  padding-top: 14px;
+  color: var(--muted);
+  font-size: 12px;
+}
+.synced-label { color: var(--green); }
+.folder-review-button {
+  margin-left: auto;
+  border: 0;
+  border-radius: 10px;
+  padding: 9px 13px;
+  background: #e6f0e7;
+  color: #245f43;
+  font-size: 12px;
+  font-weight: 750;
+}
+.folder-card-list {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 13px;
+  padding-bottom: 100px;
+}
+.flashcard-preview {
+  min-height: 155px;
+  padding: 22px;
+  border: 1px solid var(--border);
+  border-radius: 17px;
+  background: var(--surface);
+  color: var(--cream);
+  box-shadow: var(--shadow-soft);
+  font-size: clamp(15px, 2vw, 19px);
+  font-weight: 600;
+  line-height: 1.45;
+}
+.flashcard-preview img { max-height: 160px; }
+
+.study-screen {
+  width: min(100%, 740px);
+  min-height: calc(100vh - 110px);
+  margin: 0 auto;
+  padding-bottom: 24px;
+}
+.study-session-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin: 8px 2px 12px; }
+.study-session-head > div { display: flex; flex-direction: column; gap: 5px; }
+.study-session-head strong { color: var(--cream); font-size: 16px; font-weight: 750; }
+.study-session-count { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
+.study-progress-track { width: 100%; height: 5px; overflow: hidden; border-radius: 99px; background: #e1e9e1; }
+.study-progress-fill { height: 100%; border-radius: inherit; background: var(--green); transition: width .24s ease; }
+.study-question-label { margin: 27px 4px 10px; color: var(--muted); font-size: 10px; font-weight: 800; letter-spacing: .14em; }
+.study-card {
+  min-height: min(54vh, 480px);
+  padding: clamp(28px, 5vw, 54px);
+  border: 1px solid var(--border);
+  border-radius: 23px;
+  background: var(--surface);
+  color: #17251d;
+  box-shadow: 0 16px 40px rgba(26, 50, 35, .07);
+  font-size: clamp(23px, 4vw, 34px);
+  font-weight: 620;
+  letter-spacing: -.035em;
+  line-height: 1.35;
+  overflow-wrap: anywhere;
+  transition: border-color .18s ease;
+}
+.study-card.answer-visible { border-color: #b6d8bf; background: #fbfdf9; }
+.study-card > span { max-width: 30ch; }
+.study-card img { max-width: 100%; max-height: 48vh; }
+.study-navigation { justify-content: center; gap: 30px; padding: 13px 0 2px; }
+.study-navigation button {
+  width: 48px;
+  height: 48px;
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  background: var(--surface);
+  color: var(--cream);
+  font-size: 21px;
+}
+.study-hint { margin: 12px 0 0; color: var(--muted); text-align: center; font-size: 12px; }
+.recall-rating { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; margin-top: 16px; }
+.recall-rating button {
+  min-height: 68px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  border: 1px solid transparent;
+  border-radius: 13px;
+  color: #26382c;
+  transition: transform .12s ease, filter .12s ease;
+}
+.recall-rating button:active { transform: scale(.97); }
+.recall-rating strong { font-size: 14px; font-weight: 800; }
+.recall-rating span { font-size: 10px; opacity: .78; }
+.grade-again { background: #f8e9e5; border-color: #f0d4cd !important; }
+.grade-hard { background: #fbf0dc; border-color: #f1e3c5 !important; }
+.grade-good { background: #e5f1e6; border-color: #d4e7d7 !important; }
+.grade-easy { background: #e2efee; border-color: #cfe3df !important; }
+.session-complete {
+  min-height: min(65vh, 560px);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: 35px 22px;
+  border: 1px solid var(--border);
+  border-radius: 22px;
+  background: var(--surface);
+  box-shadow: var(--shadow-soft);
+  text-align: center;
+}
+.completion-mark {
+  width: 58px;
+  height: 58px;
+  display: grid;
+  place-items: center;
+  margin-bottom: 20px;
+  border-radius: 50%;
+  background: #e5f1e6;
+  color: var(--green);
+  font-size: 28px;
+  font-weight: 800;
+}
+.session-complete h2 { margin: 10px 0 5px; font-size: 27px; letter-spacing: -.05em; }
+.session-complete p { max-width: 38ch; margin: 0 0 22px; color: var(--muted); font-size: 14px; line-height: 1.6; }
+
+.editor-screen { gap: 12px; }
+.editor-guidance {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+  margin-bottom: 5px;
+  padding: 16px 18px;
+  border: 1px solid var(--border);
+  border-radius: 15px;
+  background: #eaf1e9;
+}
+.editor-guidance strong { font-size: 15px; }
+.editor-guidance p { margin: 0; color: #607166; font-size: 12px; line-height: 1.5; }
+.editor-side-indicator { margin: 6px 2px -5px; color: var(--muted); font-size: 10px; font-weight: 800; letter-spacing: .14em; }
+.card-editor-text, .text-field, .settings-field select {
+  border: 1px solid var(--border);
+  border-radius: 15px;
+  background: var(--surface);
+  color: var(--cream);
+}
+.card-editor-text {
+  min-height: min(42vh, 370px);
+  padding: 30px 24px;
+  font-size: clamp(21px, 4vw, 28px);
+  font-weight: 600;
+  letter-spacing: -.025em;
+  line-height: 1.45;
+}
+.card-editor-text::placeholder { color: #a1ada4; }
+.editor-counter { color: var(--muted); font-size: 11px; }
+.editor-image-preview { border: 1px solid var(--border); background: var(--surface); }
+.editor-image-preview strong { color: var(--cream); }
+.soft-button { border: 1px solid var(--border); background: var(--surface-2); color: var(--cream); font-size: 14px; font-weight: 700; }
+.primary-button {
+  min-height: 48px;
+  border-radius: 13px;
+  padding: 13px 19px;
+  background: var(--green);
+  color: #fff;
+  font-size: 13px;
+  font-weight: 800;
+  letter-spacing: .02em;
+}
+.save-button { width: 100%; }
+.flip-editor { color: var(--green); font-size: 34px; }
+
+.modal-backdrop { background: rgba(15, 31, 21, .48); backdrop-filter: blur(5px); }
+.image-picker-modal { border: 1px solid var(--border); border-radius: 21px; background: var(--surface); color: var(--cream); box-shadow: 0 22px 60px rgba(10, 30, 18, .2); }
+.modal-title { font-size: 21px; letter-spacing: -.04em; }
+.image-picker-modal p { color: var(--muted); line-height: 1.55; }
+.mode-preview { border: 1px solid var(--border); background: #f5f7f4; color: var(--cream); }
+.mode-preview.selected { border-color: var(--green); background: #eaf3e9; }
+.mode-preview-size { color: var(--muted); }
+.play-option { border: 1px solid var(--border); background: #f7f9f6; color: var(--cream); }
+.play-option-icon { background: #e5f0e6; color: var(--green); }
+
+.sync-screen, .settings-screen { gap: 13px; }
+.device-panel, .settings-card, .quote-editor {
+  border: 1px solid var(--border);
+  border-radius: 17px;
+  background: var(--surface);
+  box-shadow: var(--shadow-soft);
+}
+.device-panel { padding: 21px; }
+.device-heading strong { font-size: 20px; }
+.device-heading span, .connection-message { color: var(--muted); }
+.bluetooth-symbol { width: 52px; height: 52px; border-radius: 14px; background: #e8f0e9; color: var(--green); font-size: 28px; }
+.panel-divider { height: 1px; background: var(--border); }
+.storage-label { color: var(--muted); }
+.storage-track { height: 9px; border: 0; background: #e7eee6; }
+.storage-fill { background: var(--green); }
+.stat-tile { min-height: 100px; border: 1px solid var(--border); background: #f6f8f5; }
+.stat-tile span { color: var(--muted); }
+.stat-tile strong { color: var(--cream); font-family: inherit; font-size: 24px; font-weight: 750; }
+.protocol-note, .last-sync, .settings-footnote { color: var(--muted); }
+.disconnect-button { color: var(--red); font-size: 13px; font-weight: 750; }
+.settings-card { padding: 16px; }
+.settings-card span { color: var(--muted); }
+.settings-card input { accent-color: var(--green); }
+.quote-editor { padding: 17px; }
+.quote-editor-title { font-size: 16px; }
+.quote-editor p, .mode-hint { color: var(--muted); }
+.quote-editor textarea.text-field { min-height: 80px; }
+.mascot-preview { width: 108px; color: #193a2b; }
+.custom-quote { border: 1px solid var(--border); background: #f5f7f4; }
+.custom-quote-emotion { border-color: var(--border); background: var(--surface); color: var(--cream); }
+.settings-field { color: var(--muted); }
+.forget-device { background: #f8e9e5; color: #8b433b; }
+.empty-state { border-color: #cbd8cb; color: var(--muted); }
+.toast { background: #183d2c; color: #fff; box-shadow: 0 8px 26px rgba(15, 43, 28, .2); }
+.loading-screen { color: var(--muted); }
+.loading-screen .ollo-mascot { color: #193a2b; }
+
+@media (min-width: 760px) {
+  .app-shell { padding-top: 24px; }
+  .motivation-row { min-height: 180px; }
+  .study-screen { min-height: 650px; }
+  .study-card { min-height: 420px; }
+}
+@media (max-width: 600px) {
+  .app-shell { padding-left: 20px; padding-right: 20px; }
+  .motivation-row { min-height: 165px; gap: 8px; }
+  .quote { font-size: clamp(18px, 5vw, 23px); }
+  .ollo-mascot { width: clamp(128px, 40vw, 170px); }
+  .folder-list, .folder-card-list { grid-template-columns: 1fr; gap: 11px; }
+  .folder-tile { min-height: 88px; }
+  .folder-card-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .flashcard-preview { min-height: 130px; padding: 14px; font-size: 15px; }
+  .review-launch { align-items: flex-start; flex-direction: column; gap: 14px; padding: 18px; }
+  .review-launch-action { align-self: stretch; justify-content: space-between; }
+  .recall-rating { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .study-card { min-height: min(48vh, 410px); }
+  .home-bottom-actions { width: calc(100% - 40px); }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
+}
