@@ -0,0 +1,58 @@
+import type { Card, ReviewState } from './types';
+
+export type RecallGrade = 'again' | 'hard' | 'good' | 'easy';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const TEN_MINUTES = 10 * 60 * 1000;
+
+/** Cards without a schedule are new and should be introduced in the next review. */
+export function isCardDue(card: Pick<Card, 'review'>, now = Date.now()): boolean {
+  return !card.review || card.review.dueAt <= now;
+}
+
+/**
+ * A deliberately small, transparent interval heuristic for the first OllO release.
+ * It is not FSRS: it uses the learner's recall grade to gradually widen or shorten
+ * the next interval. A production scheduler can replace this without changing the UI.
+ */
+export function scheduleNextReview(
+  previous: ReviewState | undefined,
+  grade: RecallGrade,
+  now = Date.now()
+): ReviewState {
+  const oldInterval = previous?.intervalDays ?? 0;
+  let easeFactor = previous?.easeFactor ?? 2.5;
+  let intervalDays = oldInterval;
+  let repetitions = previous?.repetitions ?? 0;
+  let lapses = previous?.lapses ?? 0;
+  let dueAt: number;
+
+  switch (grade) {
+    case 'again':
+      intervalDays = Math.max(0.1, oldInterval * 0.25);
+      easeFactor = Math.max(1.3, easeFactor - 0.2);
+      repetitions = 0;
+      lapses += 1;
+      dueAt = now + TEN_MINUTES;
+      break;
+    case 'hard':
+      intervalDays = oldInterval > 0 ? Math.max(1, oldInterval * 1.2) : 1;
+      easeFactor = Math.max(1.3, easeFactor - 0.15);
+      repetitions += 1;
+      dueAt = now + intervalDays * DAY_MS;
+      break;
+    case 'good':
+      intervalDays = oldInterval > 0 ? Math.max(1, oldInterval * easeFactor) : 3;
+      repetitions += 1;
+      dueAt = now + intervalDays * DAY_MS;
+      break;
+    case 'easy':
+      intervalDays = oldInterval > 0 ? Math.max(4, oldInterval * easeFactor * 1.3) : 5;
+      easeFactor = Math.min(3.2, easeFactor + 0.15);
+      repetitions += 1;
+      dueAt = now + intervalDays * DAY_MS;
+      break;
+  }
+
+  return { dueAt, intervalDays, easeFactor, repetitions, lapses, lastReviewedAt: now };
+}
