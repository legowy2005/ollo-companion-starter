@@ -0,0 +1,33 @@
+.ollo-mascot {
+  display: block;
+  width: clamp(150px, 42vw, 270px);
+  flex: 0 0 auto;
+  overflow: visible;
+  color: var(--cream, #fff4eb);
+  cursor: pointer;
+  user-select: none;
+  -webkit-tap-highlight-color: transparent;
+  touch-action: manipulation;
+}
+
+/* Quote text: every word floats a little out of step with its neighbours. */
+.floaty-quote { display: block; animation: quote-drift 7.5s ease-in-out infinite; }
+.floaty-word { display: inline-block; animation: word-in .55s cubic-bezier(.2, .9, .3, 1.25) both; animation-delay: calc(var(--i) * 70ms + 260ms); }
+.floaty-word > span { display: inline-block; animation: word-float 4.4s ease-in-out infinite; animation-delay: calc(var(--i) * -380ms); }
+
+@keyframes word-in {
+  from { opacity: 0; transform: translateY(14px) scale(.9); }
+  to { opacity: 1; transform: none; }
+}
+@keyframes word-float {
+  0%, 100% { transform: translateY(0); }
+  50% { transform: translateY(-3.5px); }
+}
+@keyframes quote-drift {
+  0%, 100% { transform: rotate(0deg) translate(0, 0); }
+  50% { transform: rotate(.7deg) translate(2px, -4px); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .floaty-quote, .floaty-word, .floaty-word > span { animation: none; }
+}
diff --git a/ollo-app/src/mascot/mood.ts b/ollo-app/src/mascot/mood.ts
new file mode 100644
index 0000000..7032021
--- /dev/null
+++ b/ollo-app/src/mascot/mood.ts
@@ -0,0 +1,76 @@
+import type { PracticeStats } from '../types';
+
+export type Mood = 'neutral' | 'happy' | 'proud' | 'sad' | 'angry';
+
+/**
+ * Tweak these to change how quickly ollo gets upset or proud.
+ * "Days" are calendar days in the user's local time zone.
+ */
+export const MOOD_RULES = {
+  /** Missed this many calendar days (no practice at all) -> sad */
+  sadAfterDays: 2,
+  /** Missed this many calendar days -> angry */
+  angryAfterDays: 3,
+  /** Cards studied today needed for ollo to be proud instead of just happy */
+  proudCardsToday: 10,
+  /** A streak of this many days in a row also makes ollo proud (if at least 1 card was studied today) */
+  proudStreakDays: 3
+} as const;
+
+export function dayKey(date: Date = new Date()): string {
+  const y = date.getFullYear();
+  const m = String(date.getMonth() + 1).padStart(2, '0');
+  const d = String(date.getDate()).padStart(2, '0');
+  return `${y}-${m}-${d}`;
+}
+
+function daysBetween(fromKey: string, toKey: string): number {
+  const [fy, fm, fd] = fromKey.split('-').map(Number);
+  const [ty, tm, td] = toKey.split('-').map(Number);
+  const from = Date.UTC(fy, fm - 1, fd);
+  const to = Date.UTC(ty, tm - 1, td);
+  return Math.round((to - from) / 86_400_000);
+}
+
+/** Returns the new stats after one card has been practiced. */
+export function recordPracticeStats(previous: PracticeStats | undefined, now: Date = new Date()): PracticeStats {
+  const today = dayKey(now);
+  if (previous && previous.lastDay === today) {
+    return { ...previous, lastAt: now.getTime(), todayCount: previous.todayCount + 1 };
+  }
+  const continuesStreak = previous ? daysBetween(previous.lastDay, today) === 1 : false;
+  return {
+    lastDay: today,
+    lastAt: now.getTime(),
+    todayCount: 1,
+    streak: continuesStreak && previous ? previous.streak + 1 : 1
+  };
+}
+
+/** Picks ollo's mood from how the user has been practicing. */
+export function moodFromPractice(stats: PracticeStats | undefined, now: Date = new Date()): Mood {
+  // Brand-new user: friendly and calm, nobody to be angry at yet.
+  if (!stats) return 'neutral';
+
+  const daysSince = daysBetween(stats.lastDay, dayKey(now));
+
+  if (daysSince <= 0) {
+    const proud = stats.todayCount >= MOOD_RULES.proudCardsToday || stats.streak >= MOOD_RULES.proudStreakDays;
+    return proud ? 'proud' : 'happy';
+  }
+  if (daysSince >= MOOD_RULES.angryAfterDays) return 'angry';
+  if (daysSince >= MOOD_RULES.sadAfterDays) return 'sad';
+  return 'neutral';
+}
+
+const VALID: Mood[] = ['neutral', 'happy', 'proud', 'sad', 'angry'];
+
+/** Dev helper: open the app with ?mood=angry to preview a mood without waiting days. */
+export function moodFromUrl(): Mood | undefined {
+  try {
+    const value = new URLSearchParams(window.location.search).get('mood');
+    return VALID.find((mood) => mood === value);
+  } catch {
+    return undefined;
+  }
+}
